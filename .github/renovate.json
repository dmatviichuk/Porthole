{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "separateMajorMinor": false,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Every version update in one PR, majors included: crates and GitHub Actions",
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "groupSlug": "all"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  }
}
